{
  "clangd.enabled": true,
  "clangd.path": "/usr/bin/clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "-j=32",
    "--completion-style=detailed",
    "--cross-file-rename",
  ],
  "languageserver": {
    "golang": {
      "command": "gopls",
      "filetypes": ["go"],
      "rootPatterns": ["go.mod", ".git/"],
      "disableSnippetCompletion": false
    }
  },
  "go.goplsOptions": {
    "analyses": {
      "unusedparams": true,
      "shadow": true
    },
    "staticcheck": true
  }
}
